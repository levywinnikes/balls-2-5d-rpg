# Copy this file to .env.local (or set variables in your shell) and fill with real values.
# Never commit real API keys.

PIXELLAB_API_KEY=replace_with_real_key

# Optional endpoint overrides if your PixelLab account/docs use different routes.
PIXELLAB_BASE_URL=https://api.pixellab.ai
PIXELLAB_CREATE_PATH=/v1/generate
PIXELLAB_STATUS_PATH=/v1/jobs/{jobId}

# Optional polling controls.
PIXELLAB_POLL_MS=5000
PIXELLAB_TIMEOUT_MS=120000
