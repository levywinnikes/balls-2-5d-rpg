{
  "name": "balls-2-5d-rpg",
  "version": "0.1.0",
  "description": "An isometric RPG game",
  "author": "André Levy Scarpim Winnikes",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "classnames": "^2.5.1",
    "easystarjs": "^0.4.4",
    "lucide-react": "^0.562.0",
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-rnd": "^10.5.2",
    "react-scripts": "5.0.1",
    "simplex-noise": "^4.0.3",
    "styled-components": "^6.1.19",
    "tone": "^15.1.22",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "npm run electron-dev",
    "web": "cross-env PORT=4000 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"cross-env BROWSER=none npm run web\" \"wait-on http://localhost:4000 && cross-env ELECTRON_START_URL=http://localhost:4000 electron .\"",
    "dist": "npm run build && electron-builder",
    "build-installer": "npm run build && electron-builder --win nsis",
    "editor-server": "node scripts/map-server.js",
    "editor": "concurrently \"cross-env REACT_APP_EDITOR=true npm run web\" \"npm run editor-server\""
  },
  "build": {
    "appId": "com.balls.balls-2-5d-rpg",
    "productName": "Balls 2.5D RPG",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist_installer",
      "buildResources": "public"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "public/favicon.ico",
      "uninstallerIcon": "public/favicon.ico",
      "uninstallDisplayName": "Balls 2.5D RPG"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "wait-on": "^9.0.3"
  },
  "volta": {
    "node": "20.11.1"
  }
}
